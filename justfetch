#!/usr/bin/env bash

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

RED_FC="31"
BLUE_FC="34"
WHITE_FC="37"
WHITE="\033[0;${WHITE_FC}m"
BOLDWHITE="\033[1;${WHITE_FC}m"
ENDCOLOR="\033[0m"
BOLDBLUE="\033[1;${BLUE_FC}m"
FAINTBLUE="\033[2;${BLUE_FC}m"

logo_type="image"

logo(){
    "$SCRIPT_DIR/logo" "$@"
}

image(){
    "$SCRIPT_DIR/image" "$@"
}

show_logoconfig() {
    printf '\n%b\n' "${BOLDBLUE}JUSTFETCH LOGO CONFIGURATION${ENDCOLOR}"

    printf '\n%b\n' "${BOLDWHITE}Step 1: Create the configuration directory${ENDCOLOR}"
    printf '%s\n' "mkdir -p ~/.config/justfetch"

    printf '\n%b\n' "${BOLDWHITE}Step 2: Create the configuration file${ENDCOLOR}"
    printf '%s\n' "touch ~/.config/justfetch/config.txt"

    printf '\n%b\n' "${BOLDWHITE}Step 3: Use your path along with the logo flag${ENDCOLOR}"
    printf '%s\n' "./justfetch -l /path/to/your/logo (or) ./justfetch -i /path/to/your/image"

    printf '\n%b\n' "${BOLDWHITE}Reset to the default logo${ENDCOLOR}"
    printf '%s\n' "./justfetch --logo"
    printf '%s\n' "./justfetch --image"


    printf '\n%b\n' "${FAINTBLUE}Your custom logo/pixelated image will persist between runs.${ENDCOLOR}"
}

config(){
source ~/.config/justfetch/config.txt 
}

mode(){
source ~/.config/justfetch/mode.txt
}

information(){
source "$SCRIPT_DIR/information"
}

if [[ ! -f "$HOME/.config/justfetch/image_path.txt" ]]; then
    imagepath=""
else
    imagepath="$(cat "$HOME"/.config/justfetch/image_path.txt)"
fi

if [[ ! -f "$HOME/.config/justfetch/config.txt" ]]; then
    logopath=""
else
    logopath="$(cat "$HOME"/.config/justfetch/config.txt)"

fi

mapfile -t INFO < <("$SCRIPT_DIR/information")


while [ "$#" -gt 0 ]; do
    case "$1" in
	-h | --help)
	    echo -e "${BOLDBLUE}justfetch${ENDCOLOR}""   	"Show system information
	    echo -e "${BOLDBLUE}--help${ENDCOLOR}""   	"Show help and stop
	    echo -e "${BOLDBLUE}--version${ENDCOLOR}""   	"Show version and stop
	    echo -e "${BOLDBLUE}--json${ENDCOLOR}""   	"Show JSON format and stop
	    echo -e "${BOLDBLUE}--logoconfig${ENDCOLOR}""    "Steps to add your own logo
	    echo -e "${BOLDBLUE}--logo [PATH]${ENDCOLOR}""    "Add your own logo
	    echo -e "${BOLDBLUE}--image [PATH]${ENDCOLOR}""    "Add your own pixelated image
	    echo -e "${BOLDBLUE}--follow${ENDCOLOR}""   	"Follow me in Instagram!
	    shift
	    exit 0
	    ;;
	-v | --version)
	    echo -e "${BOLDBLUE}VERSION${ENDCOLOR}: 1.0 (INDEV)"
	    shift
	    exit 0
	    ;;
	-f | --follow)
	    echo -e "${BOLDBLUE}FOLLOW ME${ENDCOLOR}: \033]8;;http://instagram.com/heodoestech/\033\\\\${FAINTBLUE}Instagram${ENDCOLOR}\033]8;;\033\\\\"
	    shift
	    exit 0
	    ;;
	-j | --json)
	    printf '%bSystem Information: \n' "$BOLDBLUE" 
	    information
	    printf '\n%bJSON Output: \n' "$BOLDBLUE"

	    printf '%b\n{\n"user": "%s", \n"os": "%s", \n"kernel": "%s", \n"cpu": "%s", \n"gpu": "%s", \n"cpucores": %d, \n"uptime": "%s", \n"ram": "%s" \n}' "$WHITE" "$CURRENT_USER" "$OS $MACH" "$KERNEL" "$CPU" "$GPU" "$CPUCORES" "$UPTIME" "$RAM"
	    shift
	    exit 0
	    ;;

	-lc | --logoconfig)
	    show_logoconfig
	    exit 0
	    ;;
	   
	-i | --image)
	    shift
		
	    if [[ -z "$1" || "$1" == -* ]]; then
		imagepath=""
		: > "$HOME/.config/justfetch/image_path.txt"
	    else
		imagepath="$1"
		shift
		printf '%s\n' "$imagepath" > "$HOME/.config/justfetch/image_path.txt"
	    fi
	    ;;

	-l | --logo)
	    shift
	    
	    if [[ -z "$1" || "$1" == -* ]]; then
		logopath=""
		: > "$HOME/.config/justfetch/config.txt"
	    else
		logopath="$1"
		shift
		printf '%s\n' "$logopath" > "$HOME/.config/justfetch/config.txt"
	    fi
	    ;;
	*)
	    echo "Unkown argument: $1 Use justfetch {--help} for more information"
	    exit 1
	    ;;
	esac
    done

if [[ "$logo_type" == "ascii" ]]; then
    if [[ -n "$logopath" ]]; then
	mapfile -t LOGO < <("$SCRIPT_DIR/logo" "$logopath")
    else 
	mapfile -t LOGO < <("$SCRIPT_DIR/logo")
    fi
elif [[ "$logo_type" == "image" ]]; then
    if [[ -n "$imagepath" ]]; then
	mapfile -t LOGO < <("$SCRIPT_DIR/image" "$imagepath")
    else 
	mapfile -t LOGO < <("$SCRIPT_DIR/image")
    fi
fi

for i in "${!LOGO[@]}"; do
    printf '%b%-42s  %s\n' "$BOLDBLUE" "${LOGO[$i]}" "${INFO[$i]}"
done
