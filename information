#! /usr/bin/env bash

os(){
source /etc/os-release
echo "$PRETTY_NAME"
}

cpu(){
grep -m 1 'model name' /proc/cpuinfo | cut -d: -f 2 | xargs
}

terminal(){
if [[ -n "$KITTY_PID" ]]; then
    TERMINAL="Kitty"
elif [[ "$TERM_PROGRAM" == "WezTerm" ]]; then
    TERMINAL="WezTerm"
elif [[ "$TERM_PROGRAM" == "ghostty" || -n "$GHOSTTY_RESOURCES_DIR" ]]; then
    TERMINAL="Ghostty"
elif [[ "$TERM" == xterm-kitty ]]; then
    TERMINAL="Kitty"
elif [[ "$TERM" == alacritty* ]]; then
    TERMINAL="Alacritty"
elif [[ "$TERM" == foot* ]]; then
    TERMINAL="foot"
elif [[ "$TERM" == wezterm* ]]; then
    TERMINAL="WezTerm"
elif [[ "$TERM" == xterm-ghostty ]]; then
    TERMINAL="Ghostty"
elif [[ "$TERM" == tmux* ]]; then
    TERMINAL="Tmux"
elif [[ "$TERM" == screen* ]]; then
    TERMINAL="Screen"
elif [[ "$TERM" == linux ]]; then
    TERMINAL="TTY"
elif [[ "$TERM" == xterm* ]]; then
    TERMINAL="Xterm-compatible"
elif [[ "$TERM" == *-256color ]]; then
    TERMINAL="256-color terminal"
else
    TERMINAL="Unknown"
fi
echo "$TERMINAL"

}

printcolors(){
    local colors

    colors=$(seq 0 7)

    for color in $colors; do
        printf '\033[48;5;%sm   \033[0m' "$color"
    done

    printf '\n'

    colors=$(seq 8 15)

    for color in $colors; do
        printf '\033[48;5;%sm   \033[0m' "$color"
    done

    printf '\n'
}

wm() {
    if ! command -v wmctrl &>/dev/null; then
        WM="Unknown"
    else
        WM="$(wmctrl -m 2>/dev/null | awk -F': ' '/^Name:/ {print $2}')"
        WM="${WM:-None}"
    fi

    printf '%s\n' "$WM"
}

gpu(){
    check_lspci=$(command -v lspci)
    if [[ -z "$check_lspci" ]]; then
	check_lshw=$(command -v lshw)
	if [[ -z "$check_lshw" ]]; then
	   echo "Dependencies lspci and lshw not found"
	else 
	   find_lshw=$(lshw -C display | grep -m 1 'product' | cut -d: -f2)
		if [[ -z "$find_lshw" ]]; then
		   echo "GPU not found"
	   else 
		echo "$find_lshw"
	   fi
	fi
    else 
	   find_lspci=$(lspci -vmm | awk -F '\t' '
/^Class:/ {
    gpu = ($2 ~ /VGA compatible controller|3D controller|Display controller/)
}
/^Vendor:/ && gpu { vendor = $2 }
/^Device:/ && gpu { device = $2 }
/^$/ {
    if (gpu)
        print vendor, device
    gpu = 0
    vendor = device = ""
}')
		if [[ -z "$find_lspci" ]]; then
		   echo "GPU not found"
		else
		   echo "$find_lspci"
		fi
	   fi
}

NODENAME="$(uname -n)"
CURRENT_USER="$(whoami)"
OS="$(os)"
MACH="$(uname -m)"
CPU="$(cpu)"
CPUCORES="$(nproc)"
KERNEL="$(uname -r)"
UPTIME="$(uptime -p)"
RAM="$(free -h | awk '/^Mem:/ {print $3"/"$2}')"
HARDWARE="$( hostnamectl | awk '/^  Hardware Model:/ {print $3" "$4" "$5}')"
GPU="$(gpu)"
SHELL="$(ps -o comm= -p $PPID)"
WM="$(wm)"
TERMINAL="$(terminal)"
COLORS="$(printcolors)"

#DISK="$(df -h | awk '/^\/dev\/sdb3/ {print "("$3"/"$4")"" "$5}')"

display="$(
    printf '\n%s@%s\n' "$CURRENT_USER" "$NODENAME"
    printf '\nUSER       : %s' "$CURRENT_USER"
    printf '\nOS         : %s' "$OS $MACH"
    printf '\nHOST       : %s' "$HARDWARE"
    printf '\nKERNEL     : %s' "$KERNEL"
    printf '\nSHELL      : %s' "$SHELL"
    printf '\nTERMINAL   : %s' "$TERMINAL"
    printf '\nWM         : %s' "$WM"
    printf '\nCPU        : %s' "$CPU"
    printf '\nCPU CORES  : %s' "$CPUCORES"
    printf '\nGPU        : %s' "$GPU"
    printf '\nRAM        : %s' "$RAM"
    printf '\nUPTIME     : %s' "$UPTIME"
    printf '\n\n%s' "$COLORS"
)"
    mapfile -t INFORMATION <<< "$display"
    printf '%s\n' "${INFORMATION[@]}"



