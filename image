#!/usr/bin/env bash

dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
imagepath=${1:-"$dir/logos/images/meow.png"}

if [[ ! -f "$imagepath" ]]; then 
    echo "File doesn't exists use existing .png/.jpg files for better results!"
    exit 1

elif [[ "$imagepath" == *.png ]]; then 
    chafa --format=symbols --relative=off --colors=full --size=40x20 "$imagepath" > "$dir/logos/images/userimage.txt"
    mapfile -t IMG < "$dir/logos/images/userimage.txt"
    printf '%s\n' "${IMG[@]}"

elif [[ "$imagepath" == *.jpg ]]; then 
    chafa --format=symbols --relative=off --colors=full --size=40x20 "$imagepath" > "$dir/logos/images/userimage.txt"
    mapfile -t IMG < "$dir/logos/ascii/userimage.txt"
    printf '%s\n' "${IMG[@]}"

elif [[ -f "$imagepath" ]]; then
    mapfile -t IMG < "$imagepath"
    printf '%s\n' "${IMG[@]}"

else
    echo "File format is not supported use existing .png/.jpg files for better results!"
fi
